<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="bottom_sheet_root_background"> @color/whisper</item>
        <item name="bottom_sheet_view_background"> @color/bright_gray</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="StyleTextMiddle">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
    </style>

    <style name="ToolbarTitleStyle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/bressay_trial</item>
    </style>

    <style name="FrameStyle" >
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="BottomSheetRootStyle" parent="FrameStyle">
        <item name="android:background">?bottom_sheet_root_background</item>
    </style>

    <style name="WidgetStyle" parent="FrameStyle">
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ViewBottomSheetStyle" >
        <item name="android:layout_width">@dimen/bottom_sheet_view_layout_width</item>
        <item name="android:layout_height">@dimen/bottom_sheet_view_layout_height</item>
        <item name="android:layout_marginTop">@dimen/bottom_sheet_view_layout_marginTop</item>
        <item name="android:background">?bottom_sheet_view_background</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="TextViewBottomSheetDescriptionStyle" >
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/tv_paddingStart</item>
        <item name="android:paddingEnd">@dimen/tv_paddingEnd</item>
        <item name="android:fontFamily"> @font/bressay_trial</item>
    </style>

    <style name="TextViewBottomSheetHeaderStyle" parent="TextViewBottomSheetDescriptionStyle" >
        <item name="android:layout_marginTop">@dimen/tv_layout_marginTop</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:fontFamily"> @font/bressay_trial</item>

    </style>

</resources>