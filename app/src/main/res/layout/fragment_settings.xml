<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/tvIpSet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:text="Ip адрес WiFi сети"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/edIpSet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="start"
        android:hint="@string/inputName"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        android:textSize="20sp"
        android:text="192.168.1.1"
        android:inputType="number"
        app:layout_constraintEnd_toStartOf="@+id/saveIpSet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvIpSet" />

    <Button
        android:id="@+id/saveIpSet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:text="@string/save_"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/edIpSet"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/edIpSet"
        app:layout_constraintTop_toBottomOf="@+id/tvIpSet"  />

    <TextView
        android:id="@+id/tvName_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:text="Имя WiFi сети"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/saveIpSet" />

    <EditText
        android:id="@+id/edIpNameSet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="start"
        android:hint="@string/inputName"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        android:textSize="20sp"
        android:text="NodeMCU"
        app:layout_constraintEnd_toEndOf="@+id/edIpSet"
        app:layout_constraintStart_toStartOf="@+id/edIpSet"
        app:layout_constraintTop_toBottomOf="@+id/tvName_home" />

    <Button
        android:id="@+id/saveIpNameSet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/save_"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="@+id/saveIpSet"
        app:layout_constraintStart_toStartOf="@+id/saveIpSet"
        app:layout_constraintTop_toBottomOf="@+id/tvName_home" />


    <TextView
        android:id="@+id/tvPass_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:text="Пароль WiFi сети"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edIpNameSet" />

    <EditText
        android:id="@+id/edPass_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="start"
        android:hint="@string/inputName"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        android:textSize="20sp"
        android:text="12345678"
        app:layout_constraintEnd_toEndOf="@+id/edIpNameSet"
        app:layout_constraintStart_toStartOf="@+id/edIpNameSet"
        app:layout_constraintTop_toBottomOf="@+id/tvPass_home" />

    <Button
        android:id="@+id/savePass_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/save_"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="@+id/saveIpNameSet"
        app:layout_constraintStart_toStartOf="@+id/saveIpNameSet"
        app:layout_constraintTop_toBottomOf="@+id/tvPass_home" />

    <TextView
        android:id="@+id/tvInfoSet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text=""
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edPass_home" />


</androidx.constraintlayout.widget.ConstraintLayout>