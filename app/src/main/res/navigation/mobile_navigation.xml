<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/listFragment">
    <fragment
        android:id="@+id/listFragment"
        android:name="com.bartex.adresslentawifi.list.ListFragment"
         >
        <action
            android:id="@+id/action_listFragment_to_staticColorFragment"
            app:destination="@id/staticColorFragment" />
        <action
            android:id="@+id/action_listFragment_to_dynamicColorsFragment"
            app:destination="@id/dynamicColorsFragment" />
        <action
            android:id="@+id/action_listFragment_to_flameFragment"
            app:destination="@id/flameFragment" />
        <action
            android:id="@+id/action_listFragment_to_runningColorsFragment"
            app:destination="@id/runningColorsFragment" />
        <action
            android:id="@+id/action_listFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_listFragment_to_actionFragment"
            app:destination="@id/actionFragment" />
        <action
            android:id="@+id/action_listFragment_to_syncroFragment"
            app:destination="@id/syncroFragment" />
    </fragment>
<!--    android:label="ListFragment"-->
    <fragment
        android:id="@+id/staticColorFragment"
        android:name="com.bartex.adresslentawifi.staticcolor.StaticColorFragment"
        />
<!--    android:label="StaticColorFragment"-->
    <fragment
        android:id="@+id/dynamicColorsFragment"
        android:name="com.bartex.adresslentawifi.dynamiccolor.DynamicColorsFragment"
        tools:layout="@layout/fragment_dynamics" />
<!--    android:label="fragment_dinamic_colors"-->
    <fragment
        android:id="@+id/flameFragment"
        android:name="com.bartex.adresslentawifi.FlameFragment" />
    <fragment
        android:id="@+id/runningColorsFragment"
        android:name="com.bartex.adresslentawifi.running.RunningColorsFragment"
      />
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.bartex.adresslentawifi.settings.SettingsFragment"
        android:label="SettingsFragment" />
    <fragment
        android:id="@+id/syncroFragment"
        android:name="com.bartex.adresslentawifi.settings.SyncroFragment"
        android:label="SyncroFragment" />
    <fragment
        android:id="@+id/actionFragment"
        android:name="com.bartex.adresslentawifi.action.ActionFragment"
        android:label="ActionFragment" >
        <action
            android:id="@+id/action_actionFragment_to_localFragment"
            app:destination="@id/localFragment" />
    </fragment>
    <fragment
        android:id="@+id/localFragment"
        android:name="com.bartex.adresslentawifi.settings.LocalFragment"
        android:label="LocalFragment" />
    <!--  android:label="RunningColorsFragment" -->
    <!--    android:label="FlameFragment"-->
</navigation>